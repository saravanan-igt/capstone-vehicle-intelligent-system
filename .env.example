# Copy to .env and adjust. Never commit real secrets.

# Shared secret between the Next.js BFF and the API in AUTH_MODE=dev. Change it.
DEV_BFF_SHARED_SECRET=change-me-local-only
AUTH_MODE=dev

# Optional: enables Gemini explanations and scanned-policy OCR/draft extraction. Without it, template
# explanations are used and uploaded documents stay in TEXT_FAILED until a key is configured.
GEMINI_API_KEY=
# Verify the model id is available to your key before use (see docs/VERSIONS.md).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
# OCR of scanned policies runs in-request; the BFF waits up to 180 s.
GEMINI_DOCUMENT_TIMEOUT_MS=150000
MAX_UPLOAD_BYTES=10485760
AI_ENABLED=true

# Local cookies over plain http (docker compose on localhost). Do not set in production.
INSECURE_COOKIES=true

# --- docker-compose.full.yml only (PostgreSQL + RLS, Redis, BullMQ worker) ---
# Owner role: migrations, seed, outbox relay. App role: the API at runtime, subject to row-level security.
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
# Per-tenant quotas (enforced when a cache Redis is configured).
AI_DAILY_BUDGET_PER_TENANT=500
UPLOADS_PER_MINUTE_PER_TENANT=10

# --- AUTH_MODE=oidc (Amazon Cognito or any OIDC provider) ---
# Cognito: OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
OIDC_ISSUER=
# BFF (confidential client, Authorization Code + PKCE)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Cognito does not publish end_session_endpoint; set its logout URL explicitly:
# https://<domain>.auth.<region>.amazoncognito.com/logout?client_id=<id>&logout_uri=<APP_BASE_URL>/login
OIDC_LOGOUT_URL=
APP_BASE_URL=http://localhost:3000
# API: Cognito access tokens carry client_id (no aud) and token_use=access.
OIDC_AUDIENCE=
OIDC_TOKEN_USE=access
OIDC_REQUIRED_SCOPE=
